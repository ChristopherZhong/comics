datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

model Role {
  // standard columns
  id        String    @id @default(uuid(7))
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")

  // model-specific columns
  name      String    @unique

  // relations
  users     User[]

  // settings
  @@map("roles")
}

model User {
  // standard columns
  id               String            @id @default(uuid(7))
  createdAt        DateTime          @default(now()) @map("created_at")
  createdBy        String?           @map("created_by")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  updatedBy        String?           @map("updated_by")

  // model-specific columns
  email            String            @unique
  password         String
  roleId           String            @map("role_id")

  // relations
  readingEventLogs ReadingEventLog[]
  readingProgress  ReadingProgress[]
  role             Role              @relation(fields: [roleId], references: [id])

  // settings
  @@map("users")
}

model Comic {
  // standard columns
  id          String    @id @default(uuid(7))
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")

  // model-specific columns
  artist      String?
  coverUrl    String?   @map("cover_url")
  description String?
  publisher   String?
  title       String
  writer      String?

  // relations
  chapters    Chapter[]

  // settings
  @@map("comics")
}

model Chapter {
  // standard columns
  id              String            @id @default(uuid(7))
  createdAt       DateTime          @default(now()) @map("created_at")
  createdBy       String?           @map("created_by")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  updatedBy       String?           @map("updated_by")

  // model-specific columns
  chapterNumber   Float             @map("chapter_number")
  comicId         String            @map("comic_id")
  pagesCount      Int               @default(0) @map("pages_count")
  title           String

  // relations
  comic           Comic             @relation(fields: [comicId], references: [id], onDelete: Cascade)
  readingLogs     ReadingEventLog[]
  readingProgress ReadingProgress[]

  // settings
  @@map("chapters")
}

enum ProgressStatus {
  UNREAD
  IN_PROGRESS
  COMPLETED
}

model ReadingProgress {
  // standard columns
  id        String         @id @default(uuid(7))
  createdAt DateTime       @default(now()) @map("created_at")
  createdBy String?        @map("created_by")
  updatedAt DateTime       @updatedAt @map("updated_at")
  updatedBy String?        @map("updated_by")

  // model-specific columns
  chapterId String         @map("chapter_id")
  status    ProgressStatus @default(UNREAD)
  userId    String         @map("user_id")

  // relations
  chapter   Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // settings
  @@unique([userId, chapterId])
  @@map("reading_progress")
}

model ReadingEventLog {
  // standard columns
  id        String         @id @default(uuid(7))
  createdAt DateTime       @default(now()) @map("created_at")
  createdBy String?        @map("created_by")
  updatedAt DateTime       @updatedAt @map("updated_at")
  updatedBy String?        @map("updated_by")

  // model-specific columns
  chapterId String         @map("chapter_id")
  status    ProgressStatus
  timestamp DateTime       @default(now())
  userId    String         @map("user_id")

  // relations
  chapter   Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // settings
  @@map("reading_event_logs")
}
