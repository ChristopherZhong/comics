datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

model Role {
  // standard columns
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now()) @map("created_at")

  // model-specific columns
  name      String   @unique

  // relations
  users     User[]

  // settings
  @@map("roles")
}

model User {
  // standard columns
  id               String            @id @default(uuid(7))
  createdAt        DateTime          @default(now()) @map("created_at")

  // model-specific columns
  email            String            @unique
  password         String
  roleId           String            @map("role_id")

  // relations
  role             Role              @relation(fields: [roleId], references: [id])
  readingProgress  ReadingProgress[]
  readingEventLogs ReadingEventLog[]

  // settings
  @@map("users")
}

model Comic {
  // standard columns
  id          String    @id @default(uuid(7))
  createdAt   DateTime  @default(now()) @map("created_at")

  // model-specific columns
  title       String
  description String?
  publisher   String?
  coverUrl    String?   @map("cover_url")
  writer      String?
  artist      String?

  // relations
  chapters    Chapter[]

  // settings
  @@map("comics")
}

model Chapter {
  // standard columns
  id              String            @id @default(uuid(7))
  createdAt       DateTime          @default(now()) @map("created_at")

  // model-specific columns
  comicId         String            @map("comic_id")
  title           String
  chapterNumber   Float             @map("chapter_number")
  pagesCount      Int               @default(0) @map("pages_count")

  // relations
  comic           Comic             @relation(fields: [comicId], references: [id], onDelete: Cascade)
  readingProgress ReadingProgress[]
  readingLogs     ReadingEventLog[]

  // settings
  @@map("chapters")
}

enum ProgressStatus {
  UNREAD
  IN_PROGRESS
  COMPLETED
}

model ReadingProgress {
  // standard columns
  id        String         @id @default(uuid(7))
  updatedAt DateTime       @updatedAt @map("updated_at")

  // model-specific columns
  userId    String         @map("user_id")
  chapterId String         @map("chapter_id")
  status    ProgressStatus @default(UNREAD)

  // relations
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter   Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  // settings
  @@unique([userId, chapterId])
  @@map("reading_progress")
}

model ReadingEventLog {
  // standard columns
  id        String         @id @default(uuid(7))
  timestamp DateTime       @default(now()) @map("timestamp")

  // model-specific columns
  userId    String         @map("user_id")
  chapterId String         @map("chapter_id")
  status    ProgressStatus

  // relations
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter   Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  // settings
  @@map("reading_event_logs")
}
